# 依赖
node_modules/

# 构建产物（Vite 输出到 web/dist）
web/dist/
assets/
*.local

# 环境与数据
.env
server/.env
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm
# 注意：server/data/banned.txt（预审词表）**随仓库分发**，不忽略 ——
# 新部署开箱就要能用昵称预审；运营可以直接改这个文件，也可以用 BANNED_FILE 指向自己的词表。
# 词表来自公开开源词库，不含任何用户数据。

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# OpenDesign 设计工具的内部目录（不属于本项目源码）：
#   .file-versions/  工具生成的历史版本快照
#   .od-skills/      工具的 web-prototype 技能包（脚手架代码，非本项目代码）
# 如需一并入库，用 git add -f .file-versions .od-skills 强制添加。
.file-versions/
.od-skills/
