# ─────────────────────────────────────────────────────────────────────────
# 前端构建期变量（Vite）。复制为仓库根目录的 `.env` 后按需修改。
# 注意：以 VITE_ 开头的变量会被打进前端产物，不要放任何密钥。
# ─────────────────────────────────────────────────────────────────────────

# 数据源模式：
#   auto  = 先探测 /api/health，可用则走真实后端，失败回落本地演示数据（默认）
#   api   = 强制走后端，连不上就报错（不做静默回落）
#   local = 只用本地演示数据，完全不请求后端
VITE_DATA_MODE=auto

# 站点名与校名（会显示在顶栏与页脚）
VITE_SITE_NAME=表白墙
VITE_SCHOOL_NAME=

# dev / preview 时把 /api 代理到哪个后端（server/ 默认监听 127.0.0.1:8080）
OD_API_TARGET=http://127.0.0.1:8080
