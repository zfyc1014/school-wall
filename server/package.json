{
  "name": "confession-wall-server",
  "version": "0.9.0-beta.1",
  "private": true,
  "description": "校园表白墙后端（内测版）：Node 内置 http + SQLite(WAL)，自托管内测门禁，面向最低配置 VPS / 香港部署",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/api-test.js && node scripts/gate-test.js && node scripts/route-sweep.js && node scripts/db-check.js",
    "test:api": "node scripts/api-test.js",
    "test:gate": "node scripts/gate-test.js",
    "test:sweep": "node scripts/route-sweep.js",
    "test:db": "node scripts/db-check.js",
    "db:check": "node scripts/db-check.js --real",
    "db:recount": "node scripts/db-check.js --recount"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  }
}
