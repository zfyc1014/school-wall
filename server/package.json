{
  "name": "confession-wall-server",
  "version": "1.0.0",
  "private": true,
  "description": "校园表白墙后端：Node 内置 http + SQLite(WAL)，面向最低配置 VPS / 香港部署",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/api-test.js && node scripts/db-check.js && node scripts/identity-test.js",
    "test:api": "node scripts/api-test.js",
    "test:db": "node scripts/db-check.js",
    "test:identity": "node scripts/identity-test.js",
    "db:check": "node scripts/db-check.js --real",
    "db:recount": "node scripts/db-check.js --recount"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  }
}
