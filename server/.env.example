# ─────────────────────────────────────────────────────────────────────────
# 校园墙后端配置。复制为 server/.env 后按需修改。
#
# 用法：服务端**自动读取**本文件（零依赖，见 src/env.js），
# 不需要 `node --env-file=.env` —— 面板/容器部署没有 shell，只有写文件这一条路。
# 优先级：命令行 / 容器 / systemd 注入的环境变量 > 这里的值。
# 测试脚本用 OD_SKIP_ENV_FILE=1 显式忽略本文件，保证结果只由显式变量决定。
# ─────────────────────────────────────────────────────────────────────────

# ── 服务 ────────────────────────────────────────────────────────────────
# 只监听本机，由 Caddy/Nginx 终止 TLS 并反代（低配 VPS 推荐）。
# 面板类部署（Pterodactyl/Wispbyte 等）会注入 SERVER_IP/SERVER_PORT，
# 此时容器内通常这两行都不用写。
#
# ⚠️ 写 PORT 时**只写数字**（例如 PORT=25565）：
#    写成 $SERVER_PORT、<端口> 这类「看起来像变量」的值会被当成非法端口忽略。
#    服务端会告警并回退到 SERVER_PORT / 8080，而不是崩溃重启。
HOST=127.0.0.1
PORT=8080
NODE_ENV=production

# 静态站点根目录。**留空即用默认值**：web/dist/index.html 存在时用 web/dist，
# 否则回退到仓库根目录（server/src/server.js 启动时探测一次）。
# 生产建议显式指向构建产物：
# WEB_ROOT=/srv/confession-wall/web/dist
INDEX_FILE=index.html

# 是否信任反向代理传来的 X-Forwarded-For / X-Real-IP（生产置 1）
TRUST_PROXY=1

# ── 账号与登录 ──────────────────────────────────────────────────────────
# 站点名（下发到前端标题与邮件标题）
SITE_NAME=校园墙

# 会话有效期（天），默认 30
# SESSION_DAYS=30
# 会话 cookie 名，默认 od_session
# SESSION_COOKIE=od_session

# 验证码有效期（秒，默认 600）与重发间隔（秒，默认 60）
# AUTH_CODE_TTL=600
# AUTH_CODE_RESEND=60
# 同一邮箱每小时最多发几封（默认 5）
# AUTH_CODE_HOURLY_MAX=5
#
# ⚠️ AUTH_CODE_ECHO=1 会把验证码直接回带在接口响应里，**仅供本地自测**；
#    生产环境（NODE_ENV=production）该值会被强制忽略。
# AUTH_CODE_ECHO=0

# 昵称修改冷却（小时，默认 168 = 7 天，0 = 不限制）
# NICKNAME_COOLDOWN_H=168

# 论坛是否全量先审后发：默认 0 = 只有命中预筛的内容才转人工，其余直接公开
# FORUM_PREMOD=0

# 功能开关（默认都开）
# FEATURE_FORUM=1
# FEATURE_DM=1

# ── 邮件：Cloudflare Email Service（发送登录验证码）──────────────────────
# 走 REST 接口（自托管 Node 进程没有 Workers 的 send_email 绑定）：
#   POST https://api.cloudflare.com/client/v4/accounts/{account_id}/email/sending/send
#
# 准备步骤：
#   1. 把发信域名接入 Cloudflare Email Sending：
#        npx wrangler email sending enable yourdomain.com
#   2. 建一个带「邮件发送」权限的 API Token
#   3. 三个变量都填上（缺任意一个即视为未配置）
#
# 未配置时的降级：验证码不外发，写入 server/data/outbox/*.json 与服务端日志，
# 并在非生产环境回带在响应里。**生产环境必须配置**，否则用户收不到验证码。
CF_ACCOUNT_ID=
CF_EMAIL_TOKEN=
CF_EMAIL_FROM=noreply@yourdomain.com
CF_EMAIL_FROM_NAME=校园墙
# CF_EMAIL_TIMEOUT_MS=8000

# ── 数据 ────────────────────────────────────────────────────────────────
# SQLite 文件路径（WAL 模式，会在同目录生成 -wal / -shm）
DB_PATH=./data/wall.db
# 页缓存大小（MB）。留空按机器内存自动定档：≤1GB→16，≤2GB→32，否则 64
# DB_CACHE_MB=16
# WAL 截断间隔（毫秒），默认 5 分钟
# DB_CHECKPOINT_MS=300000
# 保留期清理间隔（毫秒），默认 6 小时
# DB_CLEANUP_MS=21600000

# 数据保留天数。0 = 关闭按时清理（默认，删数据必须由运营方明确同意后再开）
# RETENTION_DAYS=0

# ── 安全（务必修改，勿提交真实值）────────────────────────────────────────
# 管理接口令牌，32 位随机串：openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-token
# 用于把访客 IP 与验证码做不可逆哈希（数据最小化，不落盘原始 IP）
IP_HASH_SECRET=change-me-to-another-long-random-secret
# 是否强制输出 HSTS（仅在确实全站 HTTPS 时开启）
FORCE_HTTPS=1

# ── 审核与限流 ──────────────────────────────────────────────────────────
MAX_BODY=32768
PAGE_MAX=30
# 评论字数上限（表白正文不限字数）
# COMMENT_MAX=300
# 点赞计数批量落盘间隔（毫秒）
LIKE_FLUSH_MS=1500
# 信息流短时缓存（毫秒）：把同一瞬间的并发首屏请求合并成一次查询；0 = 关闭
FEED_CACHE_MS=3000
# 合规词表文件（每行一个，支持 # 注释）；缺省不加载
BANNED_FILE=./data/banned.txt
# 词表热重载检查间隔（毫秒），默认 30000；设 0 关闭热重载
# BANNED_RELOAD_MS=30000
# 后台「鉴权失败」限流（窗口 15 分钟），防令牌爆破
ADMIN_RATE_LIMIT=10
# 后台已鉴权请求上限（窗口 5 分钟），只防脚本刷库
ADMIN_API_RATE_LIMIT=600

# ── 人机验证：Cloudflare Turnstile（可选，线上强烈建议开）─────────────────
# 保护「发送登录验证码」这一个入口：全站唯一会对外发信、也是注册漏斗第一道门。
# 两个 key 都填才启用；缺任何一个就完全不启用（不影响登录）。
#   TURNSTILE_SITE_KEY   公开的 site key（前端渲染 widget 用）
#   TURNSTILE_SECRET_KEY 服务端校验用，**只放本文件，别提交**
#   TURNSTILE_HOSTNAMES  令牌来源白名单，逗号分隔。生产只写正式域名；
#                        本地开发追加 localhost,127.0.0.1。留空 = 发码请求全部被拒。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
TURNSTILE_ACTION=login

# ── 赞助：爱发电（可选）─────────────────────────────────────────────────
# 配置入口：https://afdian.com/dashboard/dev
#   AFDIAN_USER_ID   开发者页的「用户 ID」
#   AFDIAN_TOKEN     开发者页的「API Token」（校验回调签名 + 查询订单）
#   AFDIAN_PAGE      你的爱发电主页，例如 https://afdian.com/a/yourname
#
# 三个都留空 = 不启用赞助功能：回调接口返回 404、App 里不显示「支持校园墙」入口，
# 其余功能完全不受影响。赞助是可选功能，不该成为部署门槛。
#
# 配好之后，到爱发电开发者页把「回调地址」填成：
#     https://<你的域名>/api/afdian/webhook
# 平台会在订单支付后 POST 到这里，服务端校验签名后落库并发奖。
AFDIAN_USER_ID=
AFDIAN_TOKEN=
AFDIAN_PAGE=

# 按金额分档发奖（全自动，无需审批）。格式：`金额:头衔名`，多个档位用英文分号分隔；
# 取「不超过订单金额的最高档」；@custom 表示用留言里自填的头衔。
# 默认 5:股东;10:@custom —— 发电 ≥5 元得「股东」，≥10 元得留言里自定义的头衔。
# 自定义头衔会过一遍昵称同款预审（违禁词 / 联系方式 / 冒名官方），不合格自动回落低一档；
# 管理员手动指派的头衔不会被赞助覆盖，赞助头衔之间可以逐档升级（5 元 → 10 元可升级）。
# 留空 = 只记录订单不发奖，全部交给后台「赞助」页手动绑定。
# AFDIAN_REWARD_TIERS=5:股东;10:@custom
# 留言里识别自定义头衔的关键词（默认「头衔」，同时接受「称号」「title」）
# AFDIAN_CUSTOM_KEYWORD=头衔
# 附带经验（默认 0：等级尽量由内容决定，不因赞助而变）
# AFDIAN_REWARD_EXP=0
# 接口基址与超时（自建代理时才需要改）
# AFDIAN_API_BASE=https://afdian.com/api/open
# AFDIAN_TIMEOUT_MS=8000

# ── 排查 ────────────────────────────────────────────────────────────────
# 置 1 时在进程退出前把退出码与调用栈写到 stderr，用于定位「谁触发了退出」
# DEBUG_EXIT=1
