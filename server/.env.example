# ── 服务 ────────────────────────────────────────────────────────────────
# 只监听本机，由 Caddy/Nginx 终止 TLS 并反代（低配 VPS 推荐）
HOST=127.0.0.1
PORT=8080
# 生产必须为 production：未配置 GATE_INVITE_CODES（且没有显式设置
# GATE_ALLOW_DISABLED=1）时会拒绝启动，而不是让写接口裸奔
NODE_ENV=production

# 静态站点根目录。**留空即用默认值**：web/dist/index.html 存在时用 web/dist，
# 否则回退到仓库根目录（server/src/server.js 启动时探测一次）。
# 生产建议像下面这样显式指向构建产物，避免误判：
WEB_ROOT=/srv/confession-wall/web/dist
# 首页文件名，默认 index.html（仅在请求路径为 / 时使用）
INDEX_FILE=index.html

# 是否信任反向代理传来的 X-Forwarded-For / X-Real-IP（生产置 1）
TRUST_PROXY=1

# ── 内测门禁（自托管：邀请码 + 本地挑战）─────────────────────────────────
# 取代原先的 Cloudflare Turnstile：**不依赖任何第三方、不出网、可离线部署**。
# 三层结构（见 src/gate.js）：
#   1. 内测邀请码 —— 人手一份的共享口令，服务端只保存它的 HMAC-SHA256；
#   2. 一次性本地挑战 —— 服务端出两位数的加减题（默认 2 题），答案只留在服务端内存，
#      默认 10 分钟过期、答对即作废、最多错 5 次；
#   3. 短期会话 cookie —— HMAC 签名并绑定访客 IP 哈希（HttpOnly，默认 12 小时）。
# 覆盖范围：所有**写操作**（发帖 / 评论 / 点赞 / 举报 / 反馈）都要先过门禁，
# 未通过时服务端直接返回 403 gate_required（不依赖前端按钮，前端拿不到豁免）。

# 1 = 强制开启；0 = 关闭（会打警告）。
# 默认 = 「NODE_ENV=production 且已配置邀请码」时开启；开发环境默认关闭。
# GATE_ENFORCE=1

# 邀请码，逗号或空格分隔，可配多个（**每个至少 8 位**，过短的会被忽略并打警告）。
# 生产环境不配置它就会拒绝启动 —— 没有邀请码的内测站等于对全网开放写接口。
# 请用随机串：openssl rand -hex 8
GATE_INVITE_CODES=change-me-at-least-8-chars

# 通过门禁后签发的会话有效期（秒），默认 43200（12 小时，范围 60–2592000）。
# 内测体验优先：一次答题后当天不再重复打扰。
# GATE_TTL=43200

# 挑战有效期（秒），默认 600（10 分钟，范围 30–3600）
# GATE_CHALLENGE_TTL=600

# 每次挑战的题目数，默认 2（范围 1–4）。题多则机器脚本成本高，人也会烦。
# GATE_CHALLENGE_ITEMS=2

# 单份挑战允许答错的次数，默认 5（范围 1–20），超过即作废要求重新取题
# GATE_MAX_ATTEMPTS=5

# 会话 cookie 名，默认 od_gate
# GATE_COOKIE=od_gate

# 会话 cookie 是否只允许 HTTPS 传输：默认在生产开启、开发关闭。
# 显式设 0 可以在**纯 HTTP 内网部署**下关闭它（否则浏览器会丢弃 cookie，
# 表现为「刚验证完又要求验证」的死循环 —— 这个问题只在非 localhost 的
# HTTP 地址上暴露，本机验收看不出来）。关闭时启动会打警告。
# GATE_COOKIE_SECURE=1

# 会话签名密钥。不设置则复用 IP_HASH_SECRET；建议独立生成一份便于单独轮换。
# 注意：换掉它会让所有在线会话立刻失效（用户需要重新输邀请码）。
# GATE_SECRET=

# 逃生开关：生产环境未配邀请码时，显式声明「我知道写接口对全网开放」才允许启动
# GATE_ALLOW_DISABLED=1

# ── 内测标识与反馈 ──────────────────────────────────────────────────────
# 版本号、站点标识、首屏公告、反馈开关全部由服务端下发（见 src/beta.js），
# 前端不再硬编码 —— 改文案只需改环境变量后重启，不必重新构建前端。

# 版本号，默认 0.9.0-beta.1（与 package.json 保持一致）
# BETA_VERSION=0.9.0-beta.1

# 版本标识，默认「内测版」
# BETA_NAME=内测版

# 首屏公告正文；留空用内置默认文案（内测说明 + 隐私提醒 + 反馈入口）
# BETA_NOTICE=

# 0 = 关闭反馈入口（POST /api/feedback 直接 403），默认开启
# BETA_FEEDBACK=0

# 可选：反馈邮箱，展示给用户并作为备用反馈渠道
# FEEDBACK_EMAIL=wall@example.edu

# 单条反馈正文最大长度，默认 800（范围 20–4000）
# FEEDBACK_MAX=800

# 反馈保留条数上限，默认 2000（最小 100）：
# 超过后只清理**已处理**的旧反馈，待处理的永不自动删除
# FEEDBACK_KEEP=2000

# ── 管理鉴权限流 ────────────────────────────────────────────────────────
# 管理接口的鉴权尝试上限（按 IP 哈希），窗口 15 分钟；默认 10 次。
# 内部工具批量审核时可调高，但不建议关闭。
# ADMIN_RATE_LIMIT=10

# ── 数据 ────────────────────────────────────────────────────────────────
# SQLite 文件路径（WAL 模式，会在同目录生成 -wal / -shm）
DB_PATH=./data/wall.db

# 页缓存大小（MB）。留空按机器内存自动定档：≤1GB→16，≤2GB→32，否则 64。
# DB_CACHE_MB=16
# WAL 截断间隔（毫秒），默认 5 分钟
# DB_CHECKPOINT_MS=300000
# 保留期清理间隔（毫秒），默认 6 小时
# DB_CLEANUP_MS=21600000

# 数据保留天数。0 = 关闭按时间清理（默认，删数据必须由运营方明确同意后再开）。
# 开启后会清理：超过该天数的被拒内容、已结案工单、审计日志。
# 合规上建议设 90，并在隐私政策中说明保留期限。
RETENTION_DAYS=0

# 启动时是否强制全量校准点赞计数（默认 0；仅在怀疑计数漂移时临时开）
# DB_RECOUNT_ON_BOOT=0
# 距上次校准超过多少天则在启动时校准一次（默认 7；0 表示永不）
# DB_RECOUNT_DAYS=7

# ── 安全（务必修改，勿提交真实值）───────────────────────────────────────
# 管理接口令牌，>= 32 位随机串：openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-token

# 用于把访客 IP 做不可逆哈希（PDPO 数据最小化，不落盘原始 IP）
IP_HASH_SECRET=change-me-to-another-long-random-secret

# 是否强制输出 HSTS（仅当你确实全站 HTTPS 时开启）
FORCE_HTTPS=1

# ── 限制 ────────────────────────────────────────────────────────────────
MAX_BODY=32768
PAGE_MAX=30
# 点赞计数批量落盘间隔（毫秒）
LIKE_FLUSH_MS=1500
# 信息流短时缓存（毫秒）：把同一瞬间的并发首屏请求合并成一次查询。
# 0 = 关闭。默认 3000，低配 VPS 上收益明显。
FEED_CACHE_MS=3000
# 合规词表文件（每行一个，支持 # 注释）；缺省不加载
BANNED_FILE=./data/banned.txt
# 词表热重载检查间隔（毫秒），默认 30000；设 0 关闭热重载。
# 运营更新 banned.txt 后无需重启进程，最多等一个间隔即生效。
# BANNED_RELOAD_MS=30000

# ── 排障 ────────────────────────────────────────────────────────────────
# 置 1 时在进程退出前把退出码与调用栈写到 stderr，用于定位「谁触发了退出」
# DEBUG_EXIT=1
