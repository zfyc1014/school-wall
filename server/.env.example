# ── 服务 ────────────────────────────────────────────────────────────────
# 只监听本机，由 Caddy/Nginx 终止 TLS 并反代（低配 VPS 推荐）
HOST=127.0.0.1
PORT=8080
# 生产必须为 production：未配置 Turnstile 时会拒绝启动，而不是裸奔
NODE_ENV=production

# 静态站点根目录。React 版构建产物在 web/dist：
#   仓库根目录已被 npm run build 生成过产物时用下面这行
WEB_ROOT=/srv/confession-wall/web/dist
# 站点默认首页文件名（React 版用 index.html）
INDEX_FILE=index.html

# 是否信任反向代理传来的 X-Forwarded-For / X-Real-IP（生产置 1）
TRUST_PROXY=1

# ── 人机验证（Cloudflare Turnstile）─────────────────────────────────────
# 控制台 https://dash.cloudflare.com → Turnstile → 添加站点，拿到两个密钥。
# 免费额度对校园站点绰绰有余；对国内访客可达，且不跟踪用户。
TURNSTILE_SITE_KEY=your-turnstile-sitekey
# 机密：只放在服务端，绝不要写进前端或提交进仓库
TURNSTILE_SECRET=your-turnstile-secret

# 1 = 强制（生产默认）；0 = 临时关闭（风险自担，会打警告）
CHALLENGE_ENFORCE=1

# 允许的 hostname / action 白名单（逗号分隔）。强烈建议至少配置 hostname，
# 避免别人把同一个 sitekey 嵌到别的站点上刷你的额度。
TURNSTILE_HOSTNAMES=wall.example.edu
TURNSTILE_ACTIONS=

# 通过验证后签发的会话有效期（秒）。期间写操作不再往返 Cloudflare。
CHALLENGE_TTL=1800

# Cloudflare 不可达时是否放行写请求：0 = 拒绝（默认，更安全）；
# 1 = 放行（可用性优先，但等于验证短暂失效）。
CHALLENGE_FAIL_OPEN=0

# 会话 cookie 是否只允许 HTTPS 传输（生产默认 1；本地 http 调试可设 0）
# CHALLENGE_COOKIE_SECURE=1

# 会话签名密钥。不设置则复用 IP_HASH_SECRET；建议独立设置。
# CHALLENGE_SECRET=

# 逃生开关：显式声明「我知道自己在裸奔」才允许在生产不带验证启动
# CHALLENGE_ALLOW_DISABLED=1

# ── 后台实名（手机号验证）───────────────────────────────────────────────
# 合规要求：前台可以匿名展示，但平台必须收集并验证发布者的身份标识，
# 否则出事时拿不出「我采取了措施」的凭据。未通过实名不得发布/评论/举报。
# 注意：实名 ≠ 账号系统。这里没有密码、昵称、个人主页，只有一个已验证的手机号标识。

# 1 = 强制（生产默认）；0 = 关闭（仅建议在本地开发时）
IDENTITY_ENFORCE=1

# 手机号哈希密钥。**必须设置且长期不变**：
# 改了它，所有已存的身份哈希都会对不上，老用户需要重新验证，历史内容也再无法关联。
# 不设置则复用 IP_HASH_SECRET；建议单独生成一份，便于独立轮换。
IDENTITY_SECRET=change-me-to-another-long-random-secret

# 同意条款版本号。修改告知文案后请同步提升，新的验证记录会带上新版本号（留痕用）。
IDENTITY_CONSENT_VERSION=v1.0

# 验证码有效期与重发间隔
IDENTITY_CODE_TTL_MS=600000
IDENTITY_RESEND_INTERVAL_MS=60000

# 防短信轰炸上限：同号码每日条数 / 同 IP 每小时条数 / 单个验证码可试错次数
IDENTITY_MAX_PER_DAY=8
IDENTITY_MAX_PER_HOUR_IP=10
IDENTITY_MAX_ATTEMPTS=5

# 实名会话有效期（默认 180 天：实名是低频动作，不该反复打扰用户）
IDENTITY_SESSION_TTL_MS=15552000000

# 是否要求实名后才能**阅读**。默认 0（读多写少，挡阅读会显著伤害可用性）；
# 若学校/律师要求全站实名，可置 1。
IDENTITY_REQUIRE_FOR_READS=0

# 会话 cookie 是否仅 HTTPS（生产默认 1；本地 http 调试可设 0）
# IDENTITY_COOKIE_SECURE=1

# ── 短信通道 ────────────────────────────────────────────────────────────
# log      默认。不真发短信，验证码写服务端日志。**仅限开发**：
#          生产用它等于不验证（任何人都能从日志拿到码），因此生产会拒绝启动，
#          除非显式设置 SMS_ALLOW_LOG_IN_PROD=1。
# webhook  通用模式：POST { phone, code, text, ttlMinutes } 到 SMS_WEBHOOK_URL，
#          由你的中转服务对接具体通道（阿里云/腾讯云函数、自建中转等）。
# twilio   国际通道，香港可用（中国大陆号码到达率会打折，需实测）。
SMS_PROVIDER=log

# webhook 模式必填。可选的 SMS_WEBHOOK_TOKEN 会以 Bearer 头发送。
# SMS_WEBHOOK_URL=https://sms-gateway.example.edu/send
# SMS_WEBHOOK_TOKEN=

# twilio 模式必填。TWILIO_FROM 需为该账号下已购买的号码（+852… 或 +86…）。
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# 生产环境用 log 通道时的逃生开关（后果自负：等于没有实名）
# SMS_ALLOW_LOG_IN_PROD=1

# ── 管理鉴权限流 ────────────────────────────────────────────────────────
# 管理接口每分钟的鉴权尝试上限（按 IP 哈希）。默认 15 分钟 10 次；
# 内部工具批量审核时可调高，但不建议关闭。
# ADMIN_RATE_LIMIT=10

# ── 数据 ────────────────────────────────────────────────────────────────
# SQLite 文件路径（WAL 模式，会在同目录生成 -wal / -shm）
DB_PATH=./data/wall.db

# 页缓存大小（MB）。留空按机器内存自动定档：≤1GB→16，≤2GB→32，否则 64。
# DB_CACHE_MB=16
# WAL 截断间隔（毫秒），默认 5 分钟
# DB_CHECKPOINT_MS=300000
# 保留期清理间隔（毫秒），默认 6 小时
# DB_CLEANUP_MS=21600000

# 数据保留天数。0 = 关闭按时间清理（默认，删数据必须由运营方明确同意后再开）。
# 开启后会清理：超过该天数的被拒内容、已结案工单、审计日志。
# 合规上建议设 90，并在隐私政策中说明保留期限。
RETENTION_DAYS=0

# 启动时是否强制全量校准点赞计数（默认 0；仅在怀疑计数漂移时临时开）
# DB_RECOUNT_ON_BOOT=0
# 距上次校准超过多少天则在启动时校准一次（默认 7；0 表示永不）
# DB_RECOUNT_DAYS=7

# ── 安全（务必修改，勿提交真实值）───────────────────────────────────────
# 管理接口令牌，>= 32 位随机串：openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-token

# 用于把访客 IP 做不可逆哈希（PDPO 数据最小化，不落盘原始 IP）
IP_HASH_SECRET=change-me-to-another-long-random-secret

# 是否强制输出 HSTS（仅当你确实全站 HTTPS 时开启）
FORCE_HTTPS=1

# ── 限制 ────────────────────────────────────────────────────────────────
MAX_BODY=32768
PAGE_MAX=30
# 点赞计数批量落盘间隔（毫秒）
LIKE_FLUSH_MS=1500
# 信息流短时缓存（毫秒）：把同一瞬间的并发首屏请求合并成一次查询。
# 0 = 关闭。默认 3000，低配 VPS 上收益明显。
FEED_CACHE_MS=3000
# 合规词表文件（每行一个，支持 # 注释）；缺省不加载
BANNED_FILE=./data/banned.txt
