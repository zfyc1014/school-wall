# ─────────────────────────────────────────────────────────────────────────
# systemd 单元：最低配置 VPS 常驻运行
# 安装：
#   sudo cp deploy/confession-wall.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now confession-wall
# ─────────────────────────────────────────────────────────────────────────
[Unit]
Description=校园表白墙后端 (Node + SQLite)
After=network.target
# 内测门禁（邀请码 + 本机一次性挑战）完全在本进程内完成，不需要任何出网请求；
# 保留 network-online.target 只是为了让域名解析与系统校时先就绪，
# 网络短暂不可用不会影响写操作的校验（没有第三方校验服务可等）。
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/srv/confession-wall/server
# 环境变量放在仅 root 可读的文件里，避免令牌出现在 systemctl status
EnvironmentFile=/etc/confession-wall.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=2
# 收到 SIGTERM 后，服务需要刷新点赞计数、PRAGMA optimize 并截断 WAL，
# 给足时间再强杀（这也保证下次启动不会误判为「非优雅退出」而做全量校准）
TimeoutStopSec=15
KillSignal=SIGTERM

# 最低配置机器的资源护栏（可按内存调整）
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/confession-wall/server/data
# 地址族白名单保持 AF_INET / AF_INET6 / AF_UNIX：
# 服务自身只监听回环、内测门禁也不出网，但 DNS 解析与校时仍需要 INET，
# 收紧到只留 AF_UNIX 会让服务起不来，因此这里不做进一步限制。
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
