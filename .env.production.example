# ─────────────────────────────────────────────────────────────────────────
# 前端构建期变量（Vite）。生产环境建议直接写进 CI/部署脚本的环境变量，
# 而不是把 .env 提交进仓库。
# 注意：以 VITE_ 开头的变量会被打进前端产物，**不要放任何密钥**。
# Turnstile 的 secret 只存在于服务端（server/.env）。
# ─────────────────────────────────────────────────────────────────────────

# 数据源模式：
#   生产请用 api —— 强制连后端，连不上直接报错，绝不静默回落到本地演示数据。
#   （auto 适合开发预览；local 只用于纯前端演示。）
VITE_DATA_MODE=api

# 站点名与校名（显示在顶栏与页脚，请改成真实校名）
VITE_SITE_NAME=表白墙
VITE_SCHOOL_NAME=示例大学

# 挑战测试模式：**生产必须留空/不设置**。
# 置 1 后前端会跳过 Turnstile widget 直接使用假 token，仅用于无头浏览器验收。
VITE_CHALLENGE_TEST_MODE=

# dev / preview 时把 /api 代理到哪个后端
OD_API_TARGET=http://127.0.0.1:8080
