{
  "name": "confession-wall",
  "version": "1.0.1",
  "private": true,
  "description": "校园墙：React 前端（Vite）+ 纯 Node 后端（node:http + SQLite），邮箱验证码登录、匿名表白墙、署名论坛、好友与私信",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "dev": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "preview": "vite preview --config web/vite.config.js",
    "tokens": "python scripts/check-tokens.py",
    "e2e": "node scripts/e2e.mjs",
    "e2e:admin": "node scripts/admin-e2e.mjs",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "server:install": "npm --prefix server install",
    "server:test": "npm --prefix server test",
    "verify": "python scripts/check-tokens.py && npm run build && npm --prefix server test && npm run e2e && npm run e2e:admin"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
